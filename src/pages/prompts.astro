---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Footer from "../layouts/Footer.astro";

const allPrompts = await getCollection("prompts");

const categories = [
  ...new Set(allPrompts.map((prompt) => prompt.data.category)),
];
const models = [...new Set(allPrompts.map((prompt) => prompt.data.model))];
---

<Layout title="Premium Prompt Library | 2026 AI Directory">
  <div
    class="fixed top-0 inset-x-0 h-screen bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-basement-orange/10 via-[#050505] to-[#050505] -z-10 pointer-events-none"
  >
  </div>

  <section class="max-w-7xl mx-auto px-4 pt-32 relative">
    <header class="mb-12 py-12 relative overflow-hidden rounded-3xl bg-white/5 p-8 md:p-20 border border-white/5">
      <div
        class="inline-flex items-center gap-3 px-4 py-2 bg-white/5 border border-white/10 rounded-full mb-8 backdrop-blur-md"
      >
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="text-[10px] font-mono font-bold text-white/70 uppercase tracking-[0.2em]">
          Sync_Status: Optimized
        </span>
      </div>

      <h1
        class="text-6xl md:text-8xl lg:text-9xl font-black uppercase tracking-tighter italic leading-none mb-8"
      >
        Prompt<br />
        <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-basement-orange to-button-purple"
        >
          Library_
        </span>
      </h1>

      <p
        class="text-lg md:text-xl font-mono text-white/50 max-w-2xl leading-relaxed"
      >
        Engineering-grade collection. Deterministic instructions designed for 
        advanced foundational models.
      </p>
    </header>

    <div
      class="bg-black/40 border border-white/10 rounded-3xl p-6 md:p-8 mb-20 shadow-[0_0_40px_rgba(0,0,0,0.5)] sticky top-6 z-40 backdrop-blur-xl"
    >
      <div class="flex flex-col lg:flex-row gap-8 lg:gap-16">
        <div class="flex-1">
          <h3
            class="flex items-center gap-2 text-[10px] font-mono text-white/40 uppercase tracking-[0.2em] mb-4"
          >
            <svg
              class="w-3 h-3"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path></svg
            >
            Operational Role
          </h3>
          <div class="flex flex-wrap gap-2" id="category-filters">
            <button
              class="filter-btn active-filter bg-basement-orange/10 border border-basement-orange text-basement-orange shadow-[0_0_15px_rgba(99,102,241,0.2)] px-4 py-1.5 rounded-lg text-[10px] font-bold uppercase tracking-widest transition-all"
              data-filter="all"
              data-type="category"
            >
              All Roles
            </button>
            {
              categories.map((category) => (
                <button
                  class="filter-btn bg-transparent border border-white/10 text-white/50 hover:border-white/30 hover:text-white px-4 py-1.5 rounded-lg text-[10px] font-bold uppercase tracking-widest transition-all"
                  data-filter={category}
                  data-type="category"
                >
                  {category}
                </button>
              ))
            }
          </div>
        </div>

        <div class="flex-1">
          <h3
            class="flex items-center gap-2 text-[10px] font-mono text-white/40 uppercase tracking-[0.2em] mb-4"
          >
            <svg
              class="w-3 h-3"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg
            >
            Inference Engine
          </h3>
          <div class="flex flex-wrap gap-2" id="model-filters">
            <button
              class="filter-btn active-filter bg-button-purple/10 border border-button-purple text-button-purple shadow-[0_0_15px_rgba(168,85,247,0.2)] px-4 py-1.5 rounded-lg text-[10px] font-bold uppercase tracking-widest transition-all"
              data-filter="all"
              data-type="model"
            >
              Any Engine
            </button>
            {
              models.map((model) => (
                <button
                  class="filter-btn bg-transparent border border-white/10 text-white/50 hover:border-white/30 hover:text-white px-4 py-1.5 rounded-lg text-[10px] font-bold uppercase tracking-widest transition-all"
                  data-filter={model}
                  data-type="model"
                >
                  {model}
                </button>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <div
      class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 mb-32"
      id="prompts-grid"
    >
      {
        allPrompts.map((prompt) => (
          <a
            href={`/prompts/${prompt.id}`}
            class="prompt-card group relative bg-gradient-to-b from-[#111] to-[#0a0a0a] border border-white/5 rounded-3xl p-8 hover:-translate-y-1 hover:border-white/20 hover:shadow-[0_20px_40px_rgba(0,0,0,0.4)] transition-all duration-300 flex flex-col justify-between h-full overflow-hidden"
            data-category={prompt.data.category}
            data-model={prompt.data.model}
          >
            <div class="absolute inset-0 bg-gradient-to-br from-basement-orange/0 via-transparent to-button-purple/0 group-hover:from-basement-orange/5 group-hover:to-button-purple/5 transition-colors duration-500" />

            <div class="relative z-10">
              <div class="flex justify-between items-start mb-8">
                <span class="text-[9px] font-mono font-bold uppercase tracking-widest border border-white/10 bg-white/5 px-3 py-1.5 rounded-md text-white/80">
                  {prompt.data.category}
                </span>
                <span class="flex items-center gap-1.5 text-[9px] font-mono font-bold uppercase tracking-widest text-button-purple bg-button-purple/10 px-3 py-1.5 rounded-md">
                  <span class="w-1.5 h-1.5 rounded-full bg-button-purple animate-pulse" />
                  {prompt.data.model}
                </span>
              </div>

              <h2 class="text-2xl md:text-3xl font-black uppercase italic mb-4 leading-tight group-hover:text-transparent group-hover:bg-clip-text group-hover:bg-gradient-to-r group-hover:from-white group-hover:to-white/50 transition-colors">
                {prompt.data.title}
              </h2>

              <p class="font-mono text-sm text-white/40 leading-relaxed mb-8 line-clamp-3 group-hover:text-white/60 transition-colors">
                {prompt.data.description}
              </p>
            </div>

            <div class="relative z-10 mt-auto pt-6 border-t border-white/5 flex justify-between items-center group-hover:border-white/10 transition-colors">
              <span class="text-[10px] font-mono text-white/30 uppercase tracking-widest group-hover:text-basement-orange transition-colors">
                Explore Prompt
              </span>
              <div class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center group-hover:bg-basement-orange group-hover:scale-110 transition-all duration-300">
                <svg
                  class="w-4 h-4 text-white group-hover:text-black transition-colors"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M14 5l7 7m0 0l-7 7m7-7H3"
                  />
                </svg>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </section>
  <Footer />
</Layout>

<script>
  const buttons = document.querySelectorAll(".filter-btn");
  const cards = document.querySelectorAll(".prompt-card");

  let currentCategory = "all";
  let currentModel = "all";

  const categoryActiveClasses = [
    "bg-basement-orange/10",
    "border-basement-orange",
    "text-basement-orange",
    "shadow-[0_0_15px_rgba(99,102,241,0.2)]",
  ];
  const modelActiveClasses = [
    "bg-button-purple/10",
    "border-button-purple",
    "text-button-purple",
    "shadow-[0_0_15px_rgba(168,85,247,0.2)]",
  ];
  const inactiveClasses = [
    "bg-transparent",
    "border-white/10",
    "text-white/50",
  ];

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const filterValue = button.getAttribute("data-filter") || "all";
      const filterType = button.getAttribute("data-type") || "";

      if (filterType === "category") {
        currentCategory = filterValue;
        document.querySelectorAll('[data-type="category"]').forEach((btn) => {
          btn.classList.remove(...categoryActiveClasses, "active-filter");
          btn.classList.add(...inactiveClasses);
        });
        button.classList.remove(...inactiveClasses);
        button.classList.add(...categoryActiveClasses, "active-filter");
      } else if (filterType === "model") {
        currentModel = filterValue;
        document.querySelectorAll('[data-type="model"]').forEach((btn) => {
          btn.classList.remove(...modelActiveClasses, "active-filter");
          btn.classList.add(...inactiveClasses);
        });
        button.classList.remove(...inactiveClasses);
        button.classList.add(...modelActiveClasses, "active-filter");
      }

      cards.forEach((card) => {
        const cardCategory = card.getAttribute("data-category") || "";
        const cardModel = card.getAttribute("data-model") || "";

        const categoryMatch =
          currentCategory === "all" || currentCategory === cardCategory;
        const modelMatch = currentModel === "all" || currentModel === cardModel;

        if (categoryMatch && modelMatch) {
          (card as HTMLElement).style.display = "flex";
          setTimeout(() => {
            (card as HTMLElement).style.opacity = "1";
            (card as HTMLElement).style.transform = "translateY(0)";
          }, 10);
        } else {
          (card as HTMLElement).style.opacity = "0";
          (card as HTMLElement).style.transform = "translateY(10px)";
          setTimeout(() => {
            if (
              !(
                (cardCategory === currentCategory ||
                  currentCategory === "all") &&
                (cardModel === currentModel || currentModel === "all")
              )
            ) {
              (card as HTMLElement).style.display = "none";
            }
          }, 300);
        }
      });
    });
  });
</script>

<style>
  .prompt-card {
    transition:
      opacity 0.3s ease,
      transform 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }
</style>