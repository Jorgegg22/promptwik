---
import Layout from '../layouts/Layout.astro';
import Footer from '../layouts/Footer.astro';
---

<Layout title="Contact Us | PROMPT LAB">
  <section class="max-w-4xl mx-auto px-4 pt-32 pb-24">
    <div class="text-center mb-20">
      <h1 class="text-6xl font-black uppercase italic mb-6">Contact_Us</h1>
      <p class="font-mono text-white/50 leading-relaxed uppercase tracking-wide">
        Technical support or business inquiries? <br/>Our terminal is operational.
      </p>
    </div>

    <div class="bg-white/5 border border-white/10 rounded-[2.5rem] p-10 md:p-16 shadow-2xl backdrop-blur-sm">
      <form class="space-y-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="space-y-2">
            <label class="font-mono text-[10px] text-white/40 uppercase tracking-widest">Full_Name</label>
            <input 
              type="text" 
              class="w-full bg-black/40 border border-white/10 rounded-xl px-6 py-4 font-mono text-sm focus:border-basement-orange outline-none transition-colors text-white placeholder:text-white/20" 
              placeholder="e.g., Alex Smith" 
            />
          </div>
          <div class="space-y-2">
            <label class="font-mono text-[10px] text-white/40 uppercase tracking-widest">Terminal_Email</label>
            <input 
              type="email" 
              class="w-full bg-black/40 border border-white/10 rounded-xl px-6 py-4 font-mono text-sm focus:border-basement-orange outline-none transition-colors text-white placeholder:text-white/20" 
              placeholder="alex@network.io" 
            />
          </div>
        </div>
        <div class="space-y-2">
          <label class="font-mono text-[10px] text-white/40 uppercase tracking-widest">Encoded_Message</label>
          <textarea 
            rows="5" 
            class="w-full bg-black/40 border border-white/10 rounded-xl px-6 py-4 font-mono text-sm focus:border-basement-orange outline-none transition-colors text-white placeholder:text-white/20" 
            placeholder="Type your query or transmission here..."
          ></textarea>
        </div>
        <button 
          type="submit" 
          class="w-full bg-basement-orange text-black font-black uppercase py-5 rounded-xl hover:scale-[1.02] transition-transform active:scale-95 shadow-[0_0_30px_rgba(255,85,0,0.3)]"
        >
          Send Transmission
        </button>
      </form>
    </div>

    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8 text-center font-mono uppercase text-[10px] tracking-[0.2em] text-white/30">
      <div class="p-6 border border-white/5 rounded-2xl">
        <p class="mb-2 text-white/60">Response_Time</p>
        <p>&lt; 24 Hours</p>
      </div>
      <div class="p-6 border border-white/5 rounded-2xl">
        <p class="mb-2 text-white/60">Location</p>
        <p>Distributed / Global</p>
      </div>
      <div class="p-6 border border-white/5 rounded-2xl">
        <p class="mb-2 text-white/60">Encryption</p>
        <p>End-to-End Active</p>
      </div>
    </div>
  </section>
  <Footer />
</Layout>