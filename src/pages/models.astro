---
import Layout from "../layouts/Layout.astro";
import Footer from "../layouts/Footer.astro";

const models = [
  {
    name: "GPT-5",
    developer: "OpenAI",
    version: "2026.1",
    role: "General Intelligence & Reasoning",
    stats: { logic: 98, coding: 92, creativity: 95 },
    description: "OpenAI's most balanced foundational model. Its multi-stage reasoning capabilities allow for high-level SEO workflow automation and solving complex logic puzzles with minimal supervision.",
    strengths: ["SEO Strategy Planning", "Big Data Analysis", "Zero-shot Reasoning"],
    context: "500k Tokens",
    color: "from-emerald-500 to-green-700",
    logo: "/logos/logo_gpt.png"
  },
  {
    name: "Claude 4",
    developer: "Anthropic",
    version: "Opus-V4",
    role: "Technical Writing & Deep Coding",
    stats: { logic: 95, coding: 99, creativity: 88 },
    description: "Engineered with a safety-first ethical architecture. Claude 4 is the gold standard for software engineers and technical writers, capable of generating thousands of lines of clean code and human-like prose.",
    strengths: ["Code Refactoring", "Undetectable AI Content", "Deep Document Analysis"],
    context: "1M Tokens",
    color: "from-basement-orange to-red-700",
    logo: "/logos/logo_claude.png"
  },
  {
    name: "Gemini 2.0 Pro",
    developer: "Google",
    version: "Ultra-Deep",
    role: "Multimodal Processing",
    stats: { logic: 92, coding: 90, creativity: 91 },
    description: "Google's native multimodal AI. It processes video, audio, images, and text in real-time. The ultimate tool for global market trend analysis and automated website audits within the Google ecosystem.",
    strengths: ["Workspace Integration", "Real-time Multimodality", "Live Web Search"],
    context: "2M+ Tokens",
    color: "from-button-purple to-blue-800",
    logo: "/logos/logo_gemini.jpg"
  },
  {
    name: "Llama 4",
    developer: "Meta",
    version: "Open-Source",
    role: "High-Performance Local AI",
    stats: { logic: 89, coding: 94, creativity: 85 },
    description: "The world's leading open-source LLM. Ideal for enterprises requiring on-premise deployment to ensure total data privacy without the overhead of expensive proprietary APIs.",
    strengths: ["On-Premise Privacy", "Cost-effective Fine-tuning", "High Inference Speed"],
    context: "128k Tokens",
    color: "from-blue-400 to-indigo-600",
    logo: "/logos/logo_llama.png"
  },
  {
    name: "Mistral Large 3",
    developer: "Mistral AI",
    version: "Euro-Core",
    role: "Multilingual & Efficiency",
    stats: { logic: 91, coding: 93, creativity: 84 },
    description: "The ultra-efficient European alternative. Excels in response speed and native understanding of cultural and grammatical nuances across multiple European languages better than its US rivals.",
    strengths: ["Native Multilingual SEO", "Low API Latency", "Extreme Efficiency"],
    context: "256k Tokens",
    color: "from-amber-400 to-orange-600",
    logo: "/logos/logo_mistral.png"
  },
  {
    name: "Grok 3.0",
    developer: "xAI",
    version: "Real-Time",
    role: "Live Data & Unfiltered",
    stats: { logic: 88, coding: 89, creativity: 94 },
    description: "Directly connected to the X (Twitter) real-time data stream. Grok 3 provides an edge for monitoring viral trends, breaking news, and advanced social sentiment analysis.",
    strengths: ["Real-time Data Access", "Unfiltered Reasoning", "Social Trend Tracking"],
    context: "100k Tokens",
    color: "from-zinc-500 to-black",
    logo: "/logos/logo_grok.png"
  },
  {
    name: "Perplexity Pro",
    developer: "Perplexity",
    version: "Enterprise",
    role: "Deep Research & RAG",
    stats: { logic: 96, coding: 85, creativity: 80 },
    description: "Powered by Retrieval-Augmented Generation (RAG), Perplexity is an answer engine that cites every source. Essential for academic research, fact-checked journalism, and data verification.",
    strengths: ["Source-backed Answers", "Hallucination Control", "Automated Research"],
    context: "Dynamic",
    color: "from-cyan-400 to-blue-600",
    logo: "/logos/logo_perplexity.png"
  }
];
---

<Layout title="Best AI Models 2026 | Technical Comparison & Benchmarks">
  <section class="max-w-7xl mx-auto px-4">
    
    <header class="mb-12 py-16 relative overflow-hidden rounded-[3rem] bg-white/5 p-8 md:p-20 border border-white/10 text-center shadow-xl shadow-button-purple/5">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-button-purple/10 via-transparent to-transparent opacity-50"></div>
      
      <div class="relative z-10">
        <span class="px-4 py-1 bg-basement-orange text-white text-[10px] font-black tracking-[0.3em] uppercase rounded-full mb-6 inline-block">Official Directory</span>
        <h1 class="text-5xl md:text-8xl font-black uppercase tracking-tighter italic leading-none mb-6">
          Top-Tier <span class="text-transparent bg-clip-text bg-gradient-to-r from-basement-orange to-button-purple">AI Models_</span>
        </h1>
        <p class="text-lg md:text-2xl font-mono text-white/60 max-w-4xl mx-auto italic leading-relaxed">
          Technical analysis, benchmarks, and production use cases for the LLMs dominating the 2026 Artificial Intelligence market.
        </p>
      </div>
    </header>

    <div class="space-y-12 mb-32">
      {models.map((model) => (
        <div class="group relative bg-white/5 border border-white/10 rounded-[3rem] overflow-hidden hover:border-white/20 transition-all duration-700 shadow-2xl">
          <div class="grid grid-cols-1 lg:grid-cols-12">
            
            <div class={`lg:col-span-4 bg-gradient-to-br ${model.color} p-10 flex flex-col justify-between items-start text-white relative overflow-hidden`}>
                
                <div class="w-full flex justify-between items-start relative z-10 mb-8">
                    <div class="w-24 h-24 bg-black/20 backdrop-blur-sm rounded-[1.5rem] border border-white/20 p-4 flex items-center justify-center shadow-inner">
                        <img src={model.logo} alt={`${model.name} AI Model Logo`} class="max-w-full max-h-full object-contain opacity-90 group-hover:scale-110 transition-transform duration-500" />
                    </div>
                    <span class="text-[10px] font-black uppercase tracking-widest bg-black/30 px-3 py-1 rounded-full">{model.developer}</span>
                </div>

                <div class="relative z-10 w-full">
                    <h2 class="text-4xl md:text-5xl font-black uppercase tracking-tighter italic leading-none">{model.name}</h2>
                    <p class="font-mono text-[10px] mt-3 opacity-80 uppercase tracking-widest border-b border-white/20 pb-4">Build Version: {model.version}</p>
                </div>

                <div class="w-full space-y-5 relative z-10 mt-8">
                    <div>
                        <div class="flex justify-between text-[10px] font-black uppercase mb-1"><span>Logic & SEO</span><span>{model.stats.logic}%</span></div>
                        <div class="w-full h-1.5 bg-black/20 rounded-full overflow-hidden">
                            <div class="h-full bg-white transition-all duration-1000 group-hover:w-full" style={`width: ${model.stats.logic}%`}></div>
                        </div>
                    </div>
                    <div>
                        <div class="flex justify-between text-[10px] font-black uppercase mb-1"><span>Coding Capacity</span><span>{model.stats.coding}%</span></div>
                        <div class="w-full h-1.5 bg-black/20 rounded-full overflow-hidden">
                            <div class="h-full bg-white transition-all duration-1000 group-hover:w-full" style={`width: ${model.stats.coding}%`}></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="lg:col-span-8 p-8 md:p-14 flex flex-col justify-center bg-black/40">
                <div class="grid md:grid-cols-2 gap-12">
                    <div class="space-y-6">
                        <h3 class="text-xs font-black text-basement-orange uppercase tracking-[0.2em] italic">Technical Report</h3>
                        <p class="text-base font-mono text-white/80 leading-relaxed italic">"{model.description}"</p>
                        <div class="flex flex-wrap gap-2 pt-2">
                            {model.strengths.map(tag => (
                                <span class="text-[9px] font-black uppercase border border-white/10 px-3 py-1.5 rounded-lg text-white/50 bg-white/5">{tag}</span>
                            ))}
                        </div>
                    </div>
                    <div class="bg-white/5 rounded-3xl p-8 border border-white/5 flex flex-col justify-between shadow-inner">
                        <div>
                            <h4 class="text-[10px] font-black text-button-purple uppercase tracking-widest mb-3">Primary Specialization</h4>
                            <p class="text-2xl font-black uppercase italic leading-tight text-white">{model.role}</p>
                        </div>
                        <div class="mt-8 border-t border-white/10 pt-6">
                            <span class="text-[10px] font-mono text-white/40 uppercase block mb-1">Context Window:</span>
                            <p class="text-2xl font-mono font-bold text-basement-orange">{model.context}</p>
                        </div>
                    </div>
                </div>
                <div class="mt-10 pt-8 border-t border-white/5 flex flex-col sm:flex-row justify-between items-center gap-4">
                    <span class="text-xs font-mono text-white/30 italic uppercase">System Status: Deployed & Operational</span>
                    <a href="/prompts" class="bg-white text-black px-8 py-3 rounded-xl text-xs font-black uppercase tracking-widest hover:bg-basement-orange hover:text-white transition-colors">
                        Browse Compatible Prompts →
                    </a>
                </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <section class="mb-24">
        <div class="text-center mb-12">
            <h2 class="text-4xl md:text-5xl font-black uppercase italic tracking-tighter">Direct <span class="text-button-purple">Comparison_</span></h2>
            <p class="font-mono text-white/40 mt-4 uppercase text-xs tracking-widest italic">Technical breakdown of AI industry titans</p>
        </div>

        <div class="overflow-x-auto rounded-[2.5rem] border border-white/10 bg-white/5 shadow-xl">
            <table class="w-full text-left font-mono text-sm">
                <thead class="border-b border-white/10 bg-black/20">
                    <tr>
                        <th class="p-8 text-basement-orange uppercase font-black">AI Metric</th>
                        <th class="p-8 uppercase font-black text-white">GPT-5</th>
                        <th class="p-8 uppercase font-black text-white">Claude 4</th>
                        <th class="p-8 uppercase font-black text-white">Gemini Pro</th>
                        <th class="p-8 uppercase font-black text-white">Llama 4</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/5 text-white/70">
                    <tr class="hover:bg-white/5 transition-colors">
                        <td class="p-8 font-bold text-white uppercase">Primary Case</td>
                        <td class="p-8">Automation</td>
                        <td class="p-8">Engineering</td>
                        <td class="p-8">Multimodal Analytics</td>
                        <td class="p-8">Local Deployment</td>
                    </tr>
                    <tr class="hover:bg-white/5 transition-colors">
                        <td class="p-8 font-bold text-white uppercase">Prose Quality</td>
                        <td class="p-8 text-yellow-400">Standard</td>
                        <td class="p-8 text-green-400">Exceptional</td>
                        <td class="p-8 text-yellow-400">Direct</td>
                        <td class="p-8 text-yellow-400">Variable</td>
                    </tr>
                    <tr class="hover:bg-white/5 transition-colors">
                        <td class="p-8 font-bold text-white uppercase">Web Access</td>
                        <td class="p-8">Integrated</td>
                        <td class="p-8">via Tooling</td>
                        <td class="p-8 text-green-400">Native</td>
                        <td class="p-8 text-red-400">N/A (Local)</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <article class="max-w-5xl mx-auto bg-white/5 p-8 md:p-16 rounded-[3rem] border border-white/10 mb-32 shadow-2xl">
        <header class="mb-10 border-b border-white/10 pb-8">
            <h2 class="text-4xl md:text-5xl font-black uppercase italic tracking-tighter leading-tight">
                Which <span class="text-basement-orange">Artificial Intelligence</span> should you choose?
            </h2>
            <p class="text-sm font-mono text-button-purple mt-4 uppercase tracking-widest font-bold">The Ultimate Prompt Engineering Selection Guide</p>
        </header>

        <div class="space-y-10 font-mono text-base md:text-lg text-white/70 leading-relaxed">
            <section>
                <p class="mb-6">
                    The 2026 <strong>AI market</strong> is dominated by Large Language Models (LLMs). However, choosing the right tool is only half the battle; the other half is mastering <strong>Instruction Engineering</strong>. Paying for a premium subscription to OpenAI or Anthropic yields little value if your prompts remain generic and unoptimized.
                </p>
            </section>

            <section class="pl-6 border-l-4 border-basement-orange">
                <h3 class="text-2xl font-bold text-white uppercase mb-4 italic">The King of Reasoning: GPT-5</h3>
                <p>
                    Developed by OpenAI, the GPT architecture excels in versatility. It is the best all-around assistant for complex task orchestration. To maximize its utility in SEO, marketing, or business workflows, it is vital to use <strong>high-fidelity prompts</strong> that strictly define its operational persona.
                </p>
            </section>

            <section class="pl-6 border-l-4 border-button-purple">
                <h3 class="text-2xl font-bold text-white uppercase mb-4 italic">The Developer's Choice: Claude 4</h3>
                <p>
                    If your objective is to generate clean source code, refactor applications, or write long-form technical content, <strong>Anthropic's Claude 4</strong> is the superior choice. Its massive context window allows you to upload entire code repositories and apply data extraction prompts with surgical precision.
                </p>
            </section>

            <section class="pl-6 border-l-4 border-basement-orange">
                <h3 class="text-2xl font-bold text-white uppercase mb-4 italic">The Data Powerhouse: Google Gemini</h3>
                <p>
                    Gemini shines in environmental connectivity. If your <strong>prompts</strong> require real-time spreadsheet analysis, web-based trend research, or video processing, Google’s multimodal engine is currently unrivaled in the enterprise space.
                </p>
            </section>
        </div>
    </article>

  </section>
  <Footer />
</Layout>