---
import Layout from "../layouts/Layout.astro";
import Footer from "../layouts/Footer.astro";
import { getCollection } from "astro:content";

const allPrompts = await getCollection("prompts");
const featuredPrompts = allPrompts
  .filter(p => p.data.featured)
  .slice(0, 5);
---

<Layout 
  title="PROMPTWIK | Advanced Prompt Engineering Library & AI Guides"
  description="Explore the most advanced AI prompt engineering techniques. Master Chain of Thought (CoT), RAG, and few-shot prompting for Claude, GPT-4, and Gemini."
  image="/promptwik-og.png"
  schema="WebSite"
>
  <section class="max-w-7xl mx-auto px-4">
    <header
      class="mb-12 py-12 relative overflow-hidden rounded-3xl bg-white/5 p-8 md:p-20 border border-white/5"
    >
      <div
        class="absolute top-0 right-0 text-[140px] font-black text-white opacity-[0.12] select-none italic leading-none tracking-tighter -rotate-12 translate-x-10 -translate-y-10"
      >
        SYSTEM_2026
      </div>

      <div class="flex items-center gap-4 mb-6 relative z-10">
        <span
          class="px-4 py-1 bg-button-purple text-white text-[10px] font-bold tracking-[0.2em] uppercase rounded-full"
          >Intelligence Report</span
        >
        <span
          class="text-[10px] font-mono text-white/40 uppercase tracking-widest"
          >v.1.0.4 // Global_Access</span
        >
      </div>

      <h1
        class="text-7xl md:text-[10rem] font-black uppercase tracking-tighter leading-[0.8] mb-10 relative z-10"
      >
        The New <br />
        <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-basement-orange to-button-purple"
        >
          Language Code_
        </span>
      </h1>

      <p
        class="text-xl md:text-3xl font-mono text-white/70 max-w-3xl leading-relaxed relative z-10 italic"
      >
        // Master <span class="text-white border-b-2 border-basement-orange"
          >Artificial Intelligence</span
        > with precision-engineered prompts for next-generation models.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-24">
      <a
        href="/prompts"
        class="bg-basement-orange p-10 aspect-square flex flex-col justify-between group cursor-pointer hover:bg-button-purple transition-all duration-500 rounded-[2.5rem] shadow-xl"
      >
        <span
          class="text-white font-black text-6xl group-hover:scale-110 transition-transform"
          >01</span
        >
        <div>
          <h2
            class="text-white text-4xl font-black uppercase leading-none mb-2"
          >
            Prompt<br />Library
          </h2>
          <p
            class="text-white/70 font-mono text-[11px] uppercase tracking-widest"
          >
            1,240+ AI Engineering Assets
          </p>
        </div>
      </a>

      <a
        href="/learn"
        class="bg-white p-10 aspect-square flex flex-col justify-between group cursor-pointer hover:bg-basement-orange transition-all duration-500 rounded-[2.5rem] shadow-xl"
      >
        <span
          class="text-black font-black text-6xl group-hover:scale-110 transition-transform"
          >02</span
        >
        <div>
          <h2
            class="text-black text-4xl font-black uppercase leading-none mb-2"
          >
            Learning<br />Hub
          </h2>
          <p
            class="text-black/70 font-mono text-[11px] uppercase tracking-widest"
          >
            Step-by-Step Blueprints
          </p>
        </div>
      </a>

      <a
        href="/models"
        class="bg-white/5 p-10 aspect-square flex flex-col justify-between group cursor-pointer hover:bg-white transition-all duration-500 rounded-[2.5rem] border border-white/10 group"
      >
        <span
          class="text-white group-hover:text-black font-black text-6xl italic transition-colors"
          >AI</span
        >
        <div>
          <h2
            class="text-white group-hover:text-black text-4xl font-black uppercase leading-none mb-2 transition-colors"
          >
            MODELS<br />
          </h2>
          <p
            class="text-white/40 group-hover:text-black/70 font-mono text-[11px] uppercase tracking-widest transition-colors"
          >
            Top-Tier Benchmark Analysis
          </p>
        </div>
      </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-24 items-start">
      <article
        class="lg:col-span-9 bg-white/5 p-8 md:p-20 rounded-[3rem] border border-white/5 shadow-2xl"
      >
        <div class="space-y-12">
          <header class="border-b border-white/10 pb-12">
            <h2
              class="text-5xl md:text-7xl font-black uppercase italic tracking-tighter leading-[0.9] mb-8"
            >
              The Master Guide: <br /> Mastering <span
                class="text-button-purple">AI</span
              > through Instruction Engineering
            </h2>
            <div class="flex flex-wrap gap-4">
              <span
                class="text-[11px] font-mono text-basement-orange border border-basement-orange/30 px-3 py-1 rounded-full uppercase tracking-tighter"
                >2026 Vanguard Strategy</span
              >
              <span
                class="text-[11px] font-mono text-white/30 border border-white/10 px-3 py-1 rounded-full uppercase tracking-tighter"
                >Read time: 12 min</span
              >
              <span
                class="text-[11px] font-mono text-button-purple border border-button-purple/30 px-3 py-1 rounded-full uppercase tracking-tighter"
                >Level: Professional</span
              >
            </div>
          </header>

          <div
            class="font-mono text-lg md:text-xl text-white/80 leading-relaxed space-y-10"
          >
            <p>
              In the digital fabric of 2026, <strong
                >Artificial Intelligence (AI)</strong
              > has evolved from a simple query tool into the operating system of
              human creativity. However, the effectiveness of these models lies not
              only in their architecture, but in linguistic precision. The use of
              <strong>high-fidelity prompts</strong> is now the key differentiator
              between generic automation and technical excellence.
            </p>

            <div
              class="p-10 md:p-14 border border-white/10 bg-black/40 rounded-[2rem] relative overflow-hidden group"
            >
              <div class="absolute top-0 left-0 w-2 h-full bg-button-purple">
              </div>
              <p
                class="text-2xl md:text-3xl text-white font-bold leading-snug italic relative z-10"
              >
                "We are not just learning to speak to machines; we are learning
                to program reality through semantics."
              </p>
            </div>

            <h3
              class="text-3xl md:text-4xl font-black uppercase text-white tracking-tight pt-6"
            >
              // Why Prompts Define Your Competitive Edge
            </h3>
            <p>
              A <strong>prompt</strong> is the fundamental unit of control over a
              Large Language Model (LLM). Models such as <strong
                >OpenAI's GPT-5</strong
              >,
              <strong>Anthropic's Claude 4</strong>, and <strong
                >Google's Gemini 2.0</strong
              >
              possess unprecedented cognitive capabilities but require a specific
              "key" to unlock their potential. That key is <strong
                >Prompt Engineering</strong
              >.
            </p>

            <p>
              Constructing <strong>optimized instructions</strong> is crucial for
              reducing algorithmic uncertainty. By defining clear roles, deep contexts,
              and technical constraints, we transform a random output into a high-value
              business asset.
            </p>

            <h3
              class="text-3xl md:text-4xl font-black uppercase text-white tracking-tight pt-6"
            >
              // The AI Ecosystem: Which one to choose?
            </h3>
            <p>
              To dominate <strong>Artificial Intelligence</strong>, it is vital
              to understand the specializations of each reasoning engine:
            </p>
            <div class="grid md:grid-cols-2 gap-6 pt-4">
              <div
                class="border border-white/10 p-6 rounded-2xl hover:bg-white/5 transition-colors"
              >
                <h4 class="text-basement-orange font-black mb-2">
                  OPENAI GPT-5
                </h4>
                <p class="text-sm opacity-60">
                  Ideal for high-level general reasoning and complex task
                  orchestration.
                </p>
              </div>
              <div
                class="border border-white/10 p-6 rounded-2xl hover:bg-white/5 transition-colors"
              >
                <h4 class="text-button-purple font-black mb-2">
                  ANTHROPIC CLAUDE 4
                </h4>
                <p class="text-sm opacity-60">
                  The gold standard for coding, long-form document analysis, and
                  human-like nuance.
                </p>
              </div>
              <div
                class="border border-white/10 p-6 rounded-2xl hover:bg-white/5 transition-colors"
              >
                <h4 class="text-basement-orange font-black mb-2">
                  GOOGLE GEMINI PRO
                </h4>
                <p class="text-sm opacity-60">
                  Raw power in multimodal data integration and Google's
                  productivity ecosystem.
                </p>
              </div>
              <div
                class="border border-white/10 p-6 rounded-2xl hover:bg-white/5 transition-colors"
              >
                <h4 class="text-button-purple font-black mb-2">
                  SORA & MIDJOURNEY
                </h4>
                <p class="text-sm opacity-60">
                  Visual generation engines where prompt engineering defines
                  style and cinematic fidelity.
                </p>
              </div>
            </div>

            <h3
              class="text-3xl md:text-4xl font-black uppercase text-white tracking-tight pt-6"
            >
              // Towards Autonomous Agents
            </h3>
            <p>
              The future of <strong>AI</strong> is not static. We are entering the
              era of agents that don't just respond—they execute. At Prompt Lab, we
              develop <strong>foundational prompts</strong> designed for iteration,
              allowing <strong>Artificial Intelligence</strong> to act with technical
              autonomy, from app development to critical infrastructure management.
            </p>
          </div>
        </div>
      </article>

      <aside class="lg:col-span-3 space-y-6">
        <div
          class="p-8 border border-white/10 bg-gradient-to-b from-white/5 to-transparent rounded-[2rem]"
        >
          <h3
            class="text-xs font-black text-button-purple uppercase tracking-[0.4em] mb-8"
          >
            AI_News_Feed
          </h3>
          <ul class="space-y-6 font-mono text-sm">
            <li
              class="relative p-4 rounded-2xl hover:bg-white/5 transition-colors group cursor-pointer"
            >
              <span
                class="text-[30px] font-black absolute -left-2 -top-4 opacity-10 italic"
                >01</span
              >
              <a href="#" class="block relative z-10">
                <h4
                  class="font-bold uppercase group-hover:text-basement-orange transition-colors italic leading-tight"
                >
                  GPT-5: The End of the Turing Test
                </h4>
                <p class="text-[10px] text-white/40 mt-1 uppercase italic">
                  Deep Dive
                </p>
              </a>
            </li>
            <li
              class="relative p-4 rounded-2xl hover:bg-white/5 transition-colors group cursor-pointer border-t border-white/5 pt-6"
            >
              <span
                class="text-[30px] font-black absolute -left-2 -top-4 opacity-10 italic"
                >02</span
              >
              <a href="#" class="block relative z-10">
                <h4
                  class="font-bold uppercase group-hover:text-basement-orange transition-colors italic leading-tight"
                >
                  Sora Video Update
                </h4>
                <p class="text-[10px] text-white/40 mt-1 uppercase italic">
                  Visual Engine
                </p>
              </a>
            </li>
            <li
              class="relative p-4 rounded-2xl hover:bg-white/5 transition-colors group cursor-pointer border-t border-white/5 pt-6"
            >
              <span
                class="text-[30px] font-black absolute -left-2 -top-4 opacity-10 italic"
                >03</span
              >
              <a href="#" class="block relative z-10">
                <h4
                  class="font-bold uppercase group-hover:text-basement-orange transition-colors italic leading-tight"
                >
                  Claude 4 Logic Hub
                </h4>
                <p class="text-[10px] text-white/40 mt-1 uppercase italic">
                  Benchmarks
                </p>
              </a>
            </li>
          </ul>
        </div>
      </aside>
    </div>

    <section class="pb-32">
      <div class="flex items-center gap-6 mb-12 px-2">
        <h2
          class="text-5xl font-black uppercase tracking-tighter italic text-white"
        >
          Most_Visited_<span class="text-button-purple text-3xl"></span>
        </h2>
        <div class="h-px flex-1 bg-white/10"></div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
        {featuredPrompts.map((prompt, index) => {
          const isEven = index % 2 === 0;
          const hoverBorder = isEven ? 'hover:border-button-purple' : 'hover:border-basement-orange';
          const badgeColor = isEven ? 'text-button-purple' : 'text-basement-orange';
          return (
          <a
            href={`/prompts/${prompt.id}`}
            class={`group relative border border-white/10 p-10 ${hoverBorder} transition-all bg-white/5 rounded-[2.5rem]`}
          >
            <div class="flex justify-between items-start mb-10">
              <span class={`text-[10px] font-mono font-bold ${badgeColor}`}>
                {String(index + 1).padStart(2, '0')}
              </span>
              <span
                class="text-white/20 font-mono text-[9px] group-hover:text-white transition-colors font-bold uppercase italic tracking-widest"
              >{prompt.data.category}</span>
            </div>
            <h3
              class="text-2xl font-black uppercase mb-3 leading-none group-hover:text-basement-orange transition-colors italic"
            >
              {prompt.data.title.split(' ').slice(0, 2).join(' ')}<br />{prompt.data.title.split(' ').slice(2).join(' ')}
            </h3>
            <p
              class="text-[11px] font-mono text-white/40 uppercase mb-8 leading-relaxed"
            >
              {prompt.data.description.split('.').slice(0, 1)}.
            </p>
            <div
              class="text-[10px] font-bold tracking-widest uppercase group-hover:translate-x-2 transition-transform inline-block"
            >
              Get_Access →
            </div>
          </a>
          );
        })}
      </div>
    </section>
  </section>
  <Footer />
</Layout>
