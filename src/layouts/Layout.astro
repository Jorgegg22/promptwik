---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen bg-[#18181B] text-white font-retro selection:bg-basement-orange selection:text-black">
    <div class="fixed inset-0 z-[-1] bg-[radial-gradient(circle_at_top_left,_var(--tw-gradient-stops))] from-white/5 via-transparent to-transparent opacity-60"></div>
    <div class="fixed top-0 left-0 w-full h-1 bg-gradient-to-r from-basement-orange to-button-purple z-50 shadow-[0_0_20px_rgba(255,85,0,0.5)]"></div>

    <aside class="w-72 lg:w-80 border-r border-white/10 bg-black/50 backdrop-blur-2xl hidden md:flex flex-col sticky top-0 h-screen shadow-2xl">
      <div class="p-10 border-b border-white/5">
        <a href="/" class="group block">
          <div class="text-4xl font-black tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-basement-orange to-button-purple italic leading-none group-hover:scale-105 transition-transform duration-500 origin-left">
            PROMPT<br />LAB_
          </div>
        </a>
      </div>

      <nav class="flex flex-col gap-2 p-8 text-xs font-black uppercase tracking-[0.2em]">
        <a
          href="/"
          class={`px-5 py-4 rounded-xl flex items-center gap-4 transition-all duration-300 hover:bg-white/5 hover:text-basement-orange border-l-2 ${pathname === '/' ? 'bg-white/5 border-basement-orange text-basement-orange shadow-inner' : 'border-transparent text-white/50'}`}
        >
          <span class="text-[9px] opacity-40 font-mono">01</span> HOME
        </a>
        <a
          href="/prompts"
          class={`px-5 py-4 rounded-xl flex items-center gap-4 transition-all duration-300 hover:bg-white/5 hover:text-basement-orange border-l-2 ${pathname.includes('/prompts') ? 'bg-white/5 border-basement-orange text-basement-orange shadow-inner' : 'border-transparent text-white/50'}`}
        >
          <span class="text-[9px] opacity-40 font-mono">02</span> PROMPT LIBRARY
        </a>
        <a
          href="/learn"
          class={`px-5 py-4 rounded-xl flex items-center gap-4 transition-all duration-300 hover:bg-white/5 hover:text-basement-orange border-l-2 ${pathname.includes('/learn') ? 'bg-white/5 border-basement-orange text-basement-orange shadow-inner' : 'border-transparent text-white/50'}`}
        >
          <span class="text-[9px] opacity-40 font-mono">03</span> ENGINEERING
        </a>
        <a
          href="/models"
          class={`px-5 py-4 rounded-xl flex items-center gap-4 transition-all duration-300 hover:bg-white/5 hover:text-basement-orange border-l-2 ${pathname.includes('/models') ? 'bg-white/5 border-basement-orange text-basement-orange shadow-inner' : 'border-transparent text-white/50'}`}
        >
          <span class="text-[9px] opacity-40 font-mono">04</span> AI MODELS
        </a>
      </nav>

      <div class="mt-auto p-8">
        <div class="bg-black/60 p-6 rounded-3xl border border-white/5 shadow-inner flex flex-col items-start hover:border-white/10 transition-colors">
          <p class="text-[9px] font-mono text-white/30 uppercase mb-4 tracking-[0.2em]">
            System Status
          </p>
          <div class="flex items-center gap-4 bg-white/5 px-4 py-2.5 rounded-full border border-white/5 w-full">
            <div class="relative flex h-2.5 w-2.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
            </div>
            <span class="text-[10px] font-mono text-emerald-400/90 font-bold tracking-widest uppercase">Node_Active</span>
          </div>
        </div>
      </div>
    </aside>

    <main class="flex-1 relative flex flex-col min-w-0">
      <div class="w-full h-full p-6 md:p-12 lg:p-16 xl:p-20 overflow-x-hidden">
        <slot />
      </div>
    </main>
  </body>
</html>