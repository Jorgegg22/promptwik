---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  schema?: "WebSite" | "Article" | "HowTo";
  publishedTime?: string;
  author?: string;
}

const {
  title,
  description = "Master AI with precision-engineered prompts. The ultimate library for CoT, RAG, and advanced prompt engineering.",
  image = "/promptwik-og.png",
  canonicalURL = Astro.url.href,
  schema = "WebSite",
  publishedTime,
  author = "PromptWik Team"
} = Astro.props;

const pathname = Astro.url.pathname;
const siteUrl = Astro.site?.origin || "https://promptwik.com";

const jsonLd = schema === "Article" ? {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "image": image.startsWith("http") ? image : `${siteUrl}${image}`,
  "datePublished": publishedTime,
  "author": {
    "@type": "Person",
    "name": author
  },
  "publisher": {
    "@type": "Organization",
    "name": "PromptWik",
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/promptwik.svg`
    }
  }
} : schema === "HowTo" ? {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "headline": title,
  "description": description,
  "image": image.startsWith("http") ? image : `${siteUrl}${image}`
} : {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "PromptWik",
  "url": siteUrl,
  "description": description,
  "potentialAction": {
    "@type": "SearchAction",
    "target": `${siteUrl}/prompts?q={search_term_string}`,
    "query-input": "required name=search_term_string"
  }
};
---

<!doctype html>
<html lang="en">
  <head>
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7533309416968239"
      crossorigin="anonymous"></script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/promptwik.svg" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={schema === "Article" ? "article" : "website"} />
    <meta property="og:image" content={image.startsWith("http") ? image : `${siteUrl}${image}`} />
    
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image.startsWith("http") ? image : `${siteUrl}${image}`} />
    
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body
    class="flex min-h-screen bg-[#18181B] text-white font-retro selection:bg-basement-orange selection:text-black overflow-x-hidden"
  >
    <div
      class="fixed inset-0 z-[-1] bg-[radial-gradient(circle_at_top_left,_var(--tw-gradient-stops))] from-white/5 via-transparent to-transparent opacity-60"
    >
    </div>
    <div
      class="fixed top-0 left-0 w-full h-1 bg-gradient-to-r from-basement-orange to-button-purple z-[100] shadow-[0_0_20px_rgba(255,85,0,0.5)]"
    >
    </div>

    <header
      class="md:hidden fixed top-1 left-0 w-full bg-black/80 backdrop-blur-xl border-b border-white/10 z-50 px-6 py-4 flex justify-between items-center"
    >
      <a
        href="/"
        class="text-2xl font-black tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-basement-orange to-button-purple italic"
      >
        PROMPTWIK
      </a>
      <button
        id="menu-toggle"
        class="p-2 text-white/70 hover:text-basement-orange transition-colors"
      >
        <svg
          id="menu-icon"
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16m-7 6h7"></path>
        </svg>
      </button>
    </header>

    <div
      id="mobile-menu"
      class="fixed inset-0 bg-black/95 z-[60] transform -translate-x-full transition-transform duration-500 md:hidden flex flex-col p-10"
    >
      <div class="flex justify-end mb-12">
        <button
          id="menu-close"
          class="text-white/40 hover:text-basement-orange uppercase font-mono text-[10px] tracking-widest flex items-center gap-2"
        >
          Close_Menu <span class="text-xl">×</span>
        </button>
      </div>

      <nav
        class="flex flex-col gap-6 text-xl font-black uppercase tracking-[0.2em]"
      >
        <a
          href="/"
          class={pathname === "/" ? "text-basement-orange" : "text-white/40"}
          >01 HOME</a
        >
        <a
          href="/prompts"
          class={pathname.includes("/prompts")
            ? "text-basement-orange"
            : "text-white/40"}>02 LIBRARY</a
        >
        <a
          href="/learn"
          class={pathname.includes("/learn")
            ? "text-basement-orange"
            : "text-white/40"}>03 ENGINEERING</a
        >
        <a
          href="/models"
          class={pathname.includes("/models")
            ? "text-basement-orange"
            : "text-white/40"}>04 AI MODELS</a
        >
        <a
          href="/guides"
          class={pathname.includes("/guides")
            ? "text-basement-orange"
            : "text-white/40"}>05 GUIDES</a
        >
      </nav>

      <div class="mt-auto">
        <div
          class="flex items-center gap-3 bg-white/5 p-4 rounded-2xl border border-white/5"
        >
          <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
          <span
            class="text-[10px] font-mono text-emerald-400 uppercase tracking-widest"
            >Mobile_Node_Online</span
          >
        </div>
      </div>
    </div>

    <aside
      class="w-72 lg:w-80 border-r border-white/10 bg-black/50 backdrop-blur-2xl hidden md:flex flex-col sticky top-0 h-screen shadow-2xl"
    >
      <div class="p-10 border-b border-white/5">
        <a href="/" class="group block">
          <div
            class="text-4xl font-black tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-basement-orange to-button-purple italic leading-none group-hover:scale-105 transition-transform duration-500 origin-left"
          >
            PROMPTWIK
          </div>
        </a>
      </div>

      <nav
        class="flex flex-col gap-2 p-8 text-xs font-black uppercase tracking-[0.2em]"
      >
        <a
          href="/"
          class={`px-5 py-4 rounded-xl flex items-center gap-4 transition-all duration-300 hover:bg-white/5 hover:text-basement-orange border-l-2 ${pathname === "/" ? "bg-white/5 border-basement-orange text-basement-orange shadow-inner" : "border-transparent text-white/50"}`}
        >
          <span class="text-[9px] opacity-40 font-mono">01</span> HOME
        </a>
        <a
          href="/prompts"
          class={`px-5 py-4 rounded-xl flex items-center gap-4 transition-all duration-300 hover:bg-white/5 hover:text-basement-orange border-l-2 ${pathname.includes("/prompts") ? "bg-white/5 border-basement-orange text-basement-orange shadow-inner" : "border-transparent text-white/50"}`}
        >
          <span class="text-[9px] opacity-40 font-mono">02</span> PROMPT LIBRARY
        </a>
        <a
          href="/learn"
          class={`px-5 py-4 rounded-xl flex items-center gap-4 transition-all duration-300 hover:bg-white/5 hover:text-basement-orange border-l-2 ${pathname.includes("/learn") ? "bg-white/5 border-basement-orange text-basement-orange shadow-inner" : "border-transparent text-white/50"}`}
        >
          <span class="text-[9px] opacity-40 font-mono">03</span> ENGINEERING
        </a>
        <a
          href="/models"
          class={`px-5 py-4 rounded-xl flex items-center gap-4 transition-all duration-300 hover:bg-white/5 hover:text-basement-orange border-l-2 ${pathname.includes("/models") ? "bg-white/5 border-basement-orange text-basement-orange shadow-inner" : "border-transparent text-white/50"}`}
        >
          <span class="text-[9px] opacity-40 font-mono">04</span> AI MODELS
        </a>
        <a
          href="/guides"
          class={`px-5 py-4 rounded-xl flex items-center gap-4 transition-all duration-300 hover:bg-white/5 hover:text-basement-orange border-l-2 ${pathname.includes("/guides") ? "bg-white/5 border-basement-orange text-basement-orange shadow-inner" : "border-transparent text-white/50"}`}
        >
          <span class="text-[9px] opacity-40 font-mono">05</span> GUIDES
        </a>
      </nav>

      <div class="mt-auto p-8">
        <div
          class="bg-black/60 p-6 rounded-3xl border border-white/5 shadow-inner flex flex-col items-start hover:border-white/10 transition-colors"
        >
          <p
            class="text-[9px] font-mono text-white/30 uppercase mb-4 tracking-[0.2em]"
          >
            System Status
          </p>
          <div
            class="flex items-center gap-4 bg-white/5 px-4 py-2.5 rounded-full border border-white/5 w-full"
          >
            <div class="relative flex h-2.5 w-2.5">
              <span
                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"
              ></span>
              <span
                class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"
              ></span>
            </div>
            <span
              class="text-[10px] font-mono text-emerald-400/90 font-bold tracking-widest uppercase"
              >Node_Active</span
            >
          </div>
        </div>
      </div>
    </aside>

    <main class="flex-1 relative flex flex-col min-w-0">
      <div
        class="w-full h-full p-6 pt-24 md:pt-12 md:p-12 lg:p-16 xl:p-20 overflow-x-hidden"
      >
        <slot />
      </div>
    </main>

    <script>
      const menuToggle = document.querySelector("#menu-toggle");
      const menuClose = document.querySelector("#menu-close");
      const mobileMenu = document.querySelector("#mobile-menu");

      menuToggle?.addEventListener("click", () => {
        mobileMenu?.classList.remove("-translate-x-full");
      });

      menuClose?.addEventListener("click", () => {
        mobileMenu?.classList.add("-translate-x-full");
      });
    </script>
  </body>
</html>
